PODX_DATABASE_PATH=podx_v2.db

WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_API_VERSION=v23.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose_a_private_verify_token

# Approved Meta WhatsApp Utility template used when seller is outside the
# customer-service window (for example Meta delivery error 131047).
# Compact contract: exactly one body variable {{1}} and no required buttons.
# PODX places the request summary, request id, and CONFIRM/DECLINE instruction
# inside that single variable so the seller can reply in plain text.
PODX_SELLER_INTEREST_TEMPLATE_NAME=
PODX_SELLER_INTEREST_TEMPLATE_LANGUAGE=en

# Google Maps Platform server-side route/geocoding
# Enable Geocoding API + Routes API on the same Google Cloud project.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_TIMEOUT_SECONDS=5

# Gemini voice-note understanding
GEMINI_API_KEY=your_gemini_api_key
GEMINI_VOICE_MODEL=gemini-3.6-flash
GEMINI_VOICE_MAX_BYTES=18874368

# Multi-AI image brain fallback
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5
PODX_IMAGE_AI_MIN_CONFIDENCE=0.65

# Gemini spoken replies
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Sulafat
PODX_VOICE_REPLY_ENABLED=true
PODX_VOICE_REPLY_MAX_CHARS=900
